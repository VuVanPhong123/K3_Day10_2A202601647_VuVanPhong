LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# One Gemini key, or multiple keys from independent projects separated by commas.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
REFRESH_SOURCE=0
REFRESH_TEST_SET=0
RUN_RAGAS=0
RUN_AGENT_DEMO=0
REQUIRE_LLM_JUDGE=1
MIN_CLEAN_RECORDS=3
RAGAS_MAX_WORKERS=16
RAGAS_TIMEOUT_SECONDS=180
RAGAS_MAX_RETRIES=2
RAGAS_REQUESTS_PER_MINUTE=12
